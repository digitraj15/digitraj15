# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.

# ── Where leads go ─────────────────────────────────────────
# Email address that receives contact-form submissions.
LEAD_INBOX=you@example.com

# ── Email provider: set EITHER Resend OR SMTP ──────────────
# Option A: Resend (https://resend.com). Used first if set.
RESEND_API_KEY=
# Sender. Must be on a domain you verified in Resend, e.g. "Nav Fusion Media <leads@navfusionmedia.com>".
# If empty, Resend's test sender is used (only delivers to your own Resend account email).
LEAD_FROM=

# Option B: SMTP (e.g. Gmail with an App Password, Zoho, Hostinger).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Google Sheet (optional) ─────────────────────────────────
# Web-app URL of the Apps Script in README → "Save leads to Google Sheets".
APPS_SCRIPT_URL=

# ── Analytics (optional, loaded only when set) ─────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
GA4_ID=
# Meta (Facebook/Instagram) Pixel ID, e.g. 123456789012345
PIXEL_ID=
